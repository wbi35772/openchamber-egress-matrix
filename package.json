{
  "name": "openchamber-egress-matrix",
  "version": "0.5.0",
  "private": true,
  "description": "Unified egress hub for OpenChamber: 250 contract slots (24001-24250), dual-plane routing, /64 taint ledger, blue-green rotation, local bus.",
  "license": "MIT",
  "scripts": {
    "test": "node --test --test-force-exit",
    "service": "node service/main.js"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "egress-matrix",
        "name": "Egress Matrix",
        "icon": "icon.svg",
        "entry": "ui/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  }
}
