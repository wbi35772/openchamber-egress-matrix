{
  "name": "openchamber-egress-matrix",
  "version": "0.1.0",
  "private": true,
  "description": "Independent local egress plane for OpenChamber: static proxy nodes and proxygate slots as stable mixed ports any local app can use.",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "service": "node service/main.js"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "egress-matrix",
        "name": "Egress Matrix",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  }
}
